# ===== Supabase =====
# Project URL: trouve-la dans Settings > API > Project URL
SUPABASE_URL=


# Service Role Key: trouve-la dans Settings > API > service_role secret
# (c'est la clé serveur, elle contourne le RLS)
SUPABASE_SERVICE_KEY=

# Anon Key (optionnel, pour les operations client-side si besoin)
SUPABASE_ANON_KEY=

# ===== App =====
APP_ENV=
APP_PORT=

# ===== Clé API interne =====
# Protège les endpoints qui exposent des données confidentielles
# (total_fees, calculation_detail). À générer avec: openssl rand -hex 32
INTERNAL_API_KEY=
